# API base URL is resolved automatically in src/services/api.js:
#   - dev server  -> /api (proxied to http://127.0.0.1:8000 by vite.config.js)
#   - local host  -> http://<host>:8000/api
#   - production  -> https://api.shrieelaxmi.in/api
#
# Uncomment only if you need to override the automatic detection.

# Force one base URL everywhere (local + production):
#VITE_API_BASE_URL=https://api.shrieelaxmi.in/api

# Backend URL used when the frontend is opened from a local host
# in a production build (vite build / vite preview):
#VITE_LOCAL_API_URL=http://127.0.0.1:8000/api
